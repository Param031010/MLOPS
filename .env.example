# --- Database (etl, backend) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/traffic_accidents

# --- ETL enrichment sources ---
TOMTOM_API_KEY=
OPEN_METEO_API_KEY=
WEATHER_API_KEY=

# --- Backend ---
ADMIN_TOKEN=

# --- Dashboard ---
API_BASE_URL=http://127.0.0.1:9001

# --- ML (ml, backend) ---
# Leave blank to use the default (<project>/ml/mlruns, resolved to an
# absolute file:// URI at runtime). If you set this, use an absolute
# file:///C:/... URI, not a relative path -- etl/ml/backend run from
# different working directories and must all resolve to the same store.
MLFLOW_TRACKING_URI=
